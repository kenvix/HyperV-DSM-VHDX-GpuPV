+#ifdef CONFIG_SYNO_PORT_MAPPING_V2
+static void storvsc_syno_device_info(struct scsi_device *sdev)
+{
+	struct device *controller = sdev->host->shost_gendev.parent;
+
+	if (!controller || sdev->type != TYPE_DISK ||
+	    sdev->lun > U8_MAX)
+		return;
+
+	write_lock(&sdev->syno_block_info_rwlock);
+	scnprintf(sdev->syno_block_info, sizeof(sdev->syno_block_info),
+		  "pciepath=vmbus-%s-c%u-t%u\nata_port_no=%llu\ndriver=ahci\n",
+		  dev_name(controller), sdev->channel, sdev->id,
+		  (unsigned long long)sdev->lun);
+	write_unlock(&sdev->syno_block_info_rwlock);
+}
+#endif
+
