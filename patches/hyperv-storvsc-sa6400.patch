+_is_storvsc_disk() {
+  _SV_PATH="$(readlink -f "$1/device" 2>/dev/null)"
+  while [ -n "${_SV_PATH}" ] && [ "${_SV_PATH}" != /sys ] && [ "${_SV_PATH}" != / ]; do
+    case "$(readlink "${_SV_PATH}/driver" 2>/dev/null)" in
+      */vmbus/drivers/hv_storvsc) return 0 ;;
+    esac
+    _SV_PATH="${_SV_PATH%/*}"
+  done
+  return 1
+}
+
+_vmbus_loader_disk() {
+  _VL_PART="$(/sbin/blkid -L ARC3 2>/dev/null)" || return 1
+  _VL_NAME="$(basename "$(readlink -f "${_VL_PART}" 2>/dev/null)")"
+  [ -n "${_VL_NAME}" ] && [ -r "/sys/class/block/${_VL_NAME}/partition" ] || return 1
+  _VL_SYS="$(readlink -f "/sys/class/block/${_VL_NAME}" 2>/dev/null)" || return 1
+  _VL_DISK="$(basename "$(dirname "${_VL_SYS}")")"
+  [ -d "/sys/block/${_VL_DISK}" ] || return 1
+  BOOTDISK="${_VL_DISK}"
+}
+
+_vmbus_slot() {
+  case "${_AT}" in '' | *[!0-9]*) return 1 ;; esac
+  [ "${_AT}" -le 255 ] && [ "${_DR}" = ahci ] && _is_storvsc_disk "$1" || return 1
+  if [ -z "${BOOTDISK}" ] || [ ! -d "/sys/block/${BOOTDISK}" ]; then
+    _vmbus_loader_disk || { _log "Hyper-V: cannot locate the Arc boot disk"; return 1; }
+  fi
+  ! _is_loader "$(basename "$1")" "${_PP}"
+}
